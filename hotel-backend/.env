# PostgreSQL Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/hotel_platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_platform
DB_USER=username
DB_PASSWORD=password

# SMTP Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_USE_TLS=true
EMAIL_FROM_NAME=Hotel Platform

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/certs/hotel-platform.crt
SSL_KEY_PATH=/etc/ssl/private/hotel-platform.key

# Monitoring Configuration
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=INFO
ENVIRONMENT=production

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
BACKUP_S3_BUCKET=hotel-platform-backups

# Existing configuration
STRIPE_SECRET_KEY=sk_test_51234567890abcdef
STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdef
JWT_SECRET_KEY=your-super-secret-jwt-key-here-change-in-production
SMART_LOCK_API_URL=https://api.smartlock-simulator.com
